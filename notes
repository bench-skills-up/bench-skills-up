create pnpm-workspace.yaml ->
   and add -> packages:
               - 'apps/*'
               - 'packages/*'

   OR  echo "packages:\n  - 'apps/*'\n  - 'packages/*'" > pnpm-workspace.yaml

## Install Turborepo and dev deps

pnpm add -D turbo --ignore-workspace-root-check
